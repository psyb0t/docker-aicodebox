# Container settings. Select the adapter and agent binary for your child image.
AICODEBOX_ADAPTER=
AICODEBOX_AGENT_BINARY=
AICODEBOX_WORKSPACE=/workspace
AICODEBOX_CONTAINER_NAME=aicodebox
AICODEBOX_GIT_NAME=
AICODEBOX_GIT_EMAIL=
AICODEBOX_AVAILABLE_MODELS=
AICODEBOX_AVAILABLE_EFFORTS=

# Enable one foreground mode, or Telegram together with cron.
AICODEBOX_API_MODE=0
AICODEBOX_API_MODE_PORT=8080
AICODEBOX_API_MODE_TOKEN=
AICODEBOX_TELEGRAM_MODE=0
AICODEBOX_TELEGRAM_MODE_TOKEN=
AICODEBOX_TELEGRAM_MODE_CONFIG=
AICODEBOX_TELEGRAM_MODE_OVERRIDES=
AICODEBOX_CRON_MODE=0
AICODEBOX_CRON_MODE_FILE=
AICODEBOX_CRON_MODE_HISTORY_DIR=

# MCP authentication is independent of API authentication.
AICODEBOX_MCP_MODE=0
AICODEBOX_MCP_MODE_PORT=8081
AICODEBOX_MCP_MODE_TOKEN=
AICODEBOX_MCP_MODE_ALLOWED_HOSTS=
AICODEBOX_MCP_MODE_ALLOWED_ORIGINS=
DEBUG=false
